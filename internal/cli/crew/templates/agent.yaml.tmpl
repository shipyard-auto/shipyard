schema_version: "{{.SchemaVersion}}"
name: {{.Name}}
description: "replace me — describe what this agent does"

backend:
  type: {{.BackendType}}
{{- if eq .BackendType "cli" }}
  command: ["claude", "--print"]
{{- else }}
  model: claude-sonnet-4-6
{{- end }}

execution:
  mode: {{.Mode}}
  pool: cli

conversation:
  mode: stateless

# Stateful agents keep one session per conversation key, so a chat continues
# where it left off:
#
#   conversation:
#     mode: stateful
#     key: "{{"{{input.message.chat.id}}"}}"   # one session per Telegram chat
#     key_fallback: terminal             # key used when the payload has no
#                                        # such field (a plain terminal run)
#     ttl: 8h                            # discard a session left idle this long
#     lock_wait: 5m                      # how long a second run waits for the
#                                        # first to finish on the same key
#
# ttl measures INACTIVITY, not the age of the session: every run restarts the
# clock. `ttl: 24h` on an agent someone messages daily therefore never expires
# — the session just keeps growing. To get "a fresh session each day", pick a
# window shorter than the shortest natural idle gap (8h-12h for a human-facing
# chat, so the overnight pause always resets it) rather than the length of the
# day itself.

triggers: []

# Tools this agent can call. Two styles are supported:
#   - Inline definition (same fields as a library entry)
#   - Library reference: "- ref: <tool-name>"
#     (loaded from ~/.shipyard/crew/tools/<tool-name>.yaml)
# See `shipyard crew tool add --help` to manage the library.
tools: []

# External MCP servers to expose alongside this agent's tools.
#
# Each entry references an MCP server defined in ~/.claude.json
# (key under root "mcpServers"). The `tools` field is REQUIRED and lists
# the exact tools the agent may call from that MCP server. Use ["*"] only
# when you intentionally want to expose every tool the MCP offers — there
# is no silent "expose all" default.
#
# Two patterns:
#
#   mcp_servers:
#     - ref: chrome-devtools
#       tools: [take_screenshot, click]   # whitelist
#     - ref: filesystem
#       tools: ["*"]                      # explicit "everything"
#
# Why explicit? MCP servers commonly expose tools you don't need
# (chrome-devtools also offers evaluate_javascript). Listing what the
# agent actually uses keeps blast radius scoped to intent.
#
# Missing refs hard-fail at apply time; missing or empty `tools` also
# hard-fails with a clear message.
# mcp_servers: []

# Path of the Claude Code project whose mcpServers map should be layered
# on top of the root map (matches Claude Code's per-project scoping).
# Leave commented to use root-only.
# project_scope: /absolute/path/to/project
